# ── 大模型配置 ─────────────────────────────────────────────
# 任何 OpenAI 兼容接口均可：官方 API、云厂商托管服务、或自建推理网关。
# ⚠️ 若部署在 Sealos 等云平台，base_url 必须是该平台能访问到的地址
#    （内网地址如 192.168.x.x / 10.x.x.x 从公网集群连不通）。
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=your-model-name

# 对外展示用的模型名（可选）。留空则与 LLM_MODEL 相同。
# 适用于"实际调用的 model 是网关别名，但界面想展示更友好的名称"的场景。
# LLM_DISPLAY_NAME=deepseek-v4.1-flash

# 采样温度（默认 0.7）
# ⚠️ 部分推理模型只接受 1.0，传其他值会被服务端拒绝。
# LLM_TEMPERATURE=0.7

# 输出长度上限（token，默认 4096）
# ⚠️ 推理模型的 thinking token 同样计入 max_tokens，预算太小会导致
#    正文为空（finish_reason=length），因此这里要留足余量。
# LLM_MAX_TOKENS=4096
# 配图实体抽取的输出上限（默认 1024）：同样要给推理留余量。
# 上限只是天花板，不影响实际计费。
# LLM_MAX_TOKENS_EXTRACT=1024

# ── 配图搜索（Pexels）──────────────────────────────────────
# 免费申请：https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# ── 服务端口（可选，留空用默认值）──────────────────────────
# COPYWRITER_PORT=8001
# ILLUSTRATOR_PORT=8002

# ── Mock 模式 ──────────────────────────────────────────────
# true = 不调用真实 API，返回内置示例数据（无密钥时自动开启）
MOCK_MODE=false
